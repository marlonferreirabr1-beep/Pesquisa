# ==============================================================
# PESQUISA DE SATISFAÇÃO ESCOLAR — CONFIGURAÇÕES DE AMBIENTE
# ==============================================================

# Credenciais públicas do Firebase Web (Configuradas na Vercel ou .env.local)
# Obtenha estas credenciais no Firebase Console:
# Configurações do Projeto > Seus aplicativos > Aplicativo da Web
VITE_FIREBASE_API_KEY="SUA_API_KEY_AQUI"
VITE_FIREBASE_AUTH_DOMAIN="seu-projeto.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="seu-projeto-id"
VITE_FIREBASE_STORAGE_BUCKET="seu-projeto.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef123456"

# Configurações do ambiente de produção
VITE_APP_NAME="Pesquisa de Satisfação Escolar"
VITE_SCHOOL_NAME="Colégio de Excelência"
